#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// To override the default movement or scrolling max velocities 
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Autoshift Macro
#define AS(keycode) &as LS(keycode) keycode     
// Macro to apply momentary-layer-on-hold/toggle-layer-on-tap to a specific layer
#define MO_TOG(layer) &mo_tog layer layer   

#define KEYS_L 0 1 2 3 4 5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38 // left hand
#define KEYS_R 6 7 8 9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41 // right hand
#define BASE   0
#define SYMB   1
#define NAVI   2
#define MOUS   3
#define FUNC   4
#define NPAD   5
#define SYST   6
#define COMB   7

/ {
    // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors#layer-navigation-behaviors
    behaviors {

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        hml2: hml2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };
        hmr2: hmr2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <500>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        Compose1ToNpad: Compose1ToNpad {
            compatible = "zmk,behavior-tap-dance";
            label = "Compose1ToNpad";
            #binding-cells = <0>;
            bindings = <&kp K_APP>, <&tog NAVI>;
            tapping-term-ms = <230>;
        };
        
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/hold-tap?examples=mlt#require-prior-idle-ms
        rpi: require_prior_idle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#positional-hold-tap-and-hold-trigger-key-positions
        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <1>;    // <---[[the Q key]]
        };

        // Flavors: "hold-preferred", "balanced", "tap-preferred" and "tap-unless-interrupted"
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // Autoshift applied for QWERTY keys
        // AS(Q) AS(W) AS(E) AS(R) AS(T) AS(Y) 

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#mods
        // https://v0-3-branch.zmk.dev/docs/keymaps/modifiers
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
        // &mo_tog 2 1     // &mo 2 on hold, &tog 1 on tap
        // MO_TOG(3)       // &mo 3 on hold, &tog 3 on tap
        // &mo_tog 4 3     // &mo 4 on hold, &tog 3 on tap

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#summary
        td0: td0_brave_bck_fwd {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(LBKT)>, <&kp RG(RBKT)>;
        };

        td1: td1_brave_tab_fwd_bck {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(LC(TAB))>, <&kp LC(TAB)>;
        };
        // Outputs RBKT ] on a single tab, RBRC } when the tap-dance is pressed twice.
        td2: td2_RBKT_RBRC {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RBKT>, <&kp RBRC>;
        };

        // td3: td3 {
        //     compatible = "zmk,behavior-tap-dance";
        //     #binding-cells = <0>;
        //     tapping-term-ms = <200>;
        //     bindings = <&kp A>, <&kp B>, <&kp C>;
        // };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#example-usage
        // Outputs LBKT [ on a single tap, RG on a single press and hold, and LBRC { when the tap-dance is pressed twice. 
        td_mt0: td_mt0_RG_LBKT_LBRC {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RGUI LBKT>, <&kp LBRC>;
        };
        td_mt1: td_mt1_MOUS_ESC_BASE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt MOUS ESC>, <&kt BASE>;
        };
        td_mt2: td_mt2_LG_SPACE_BASE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LGUI SPACE>, <&kt BASE>;
        };
        td_mt3: td_mt3_LG_RET_BASE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LGUI RET>, <&kt BASE>;
        };
        td_mt4: td_mt4_NAVI_BSPC_BASE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt NAVI BSPC>, <&kt BASE>;
        };
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#advanced-configuration
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/layers#configuration
        // kt_on: key_toggle_on_only {
        //     compatible = "zmk,behavior-key-toggle";
        //     #binding-cells = <1>;
        //     display-name = "Key Toggle On";
        //     toggle-mode = "on";
        // };
        // kt_off: key_toggle_off_only {
        //     compatible = "zmk,behavior-key-toggle";
        //     #binding-cells = <1>;
        //     display-name = "Key Toggle Off";
        //     toggle-mode = "off";
        // };
        // tl_on: toggle_layer_on_only {
        //     compatible = "zmk,behavior-toggle-layer";
        //     #binding-cells = <1>;
        //     display-name = "Toggle Layer On";
        //     toggle-mode = "on";
        // };
        // tl_off: toggle_layer_off_only {
        //     compatible = "zmk,behavior-toggle-layer";
        //     #binding-cells = <1>;
        //     display-name = "Toggle Layer Off";
        //     toggle-mode = "off";
        // };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/sticky-key
        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mouse-emulation
        // &mkp_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }
        // &mmv_input_listener {
        //     input-processors = <&zip_temp_layer 2 2000>;
        // }
        // &msc_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Windows specific 
        // hrm_w: hrm_w {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     tapping-term-ms = <200>;
        //     bindings = <&kp>, <&kp>;
        //     flavor = "tap-preferred";
        //     quick-tap-ms = <200>;
        //     require-prior-idle-ms = <0>;
        //     retro-tap;
        // };

        // my_mtw: my_mtw {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     flavor = "tap-preferred";
        //     tapping-term-ms = <200>;
        //     bindings = <&kp>, <&kp>;
        // };
    };
    
    combos {
        compatible = "zmk,combos";
        // https://v0-3-branch.zmk.dev/docs/keymaps/combos
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            // layers = <0 1...> 
            bindings = <&kp ESC>;
            // slow-release 
            // require-prior-idle-ms 
        };

        combo_caps1 {
            timeout-ms = <100>;
            key-positions = <36 41>; // Combo `fn + compose`
            bindings = <&kp CAPS>;
        };

        combo_caps2 {
            timeout-ms = <100>;
            key-positions = <12 23>; // Combo `left-shift+right-shift`
            bindings = <&kp CAPS>;
        };

        combo_symbol {
            timeout-ms = <100>;
            key-positions = <37 40>; // Combo `thumb ESC + thumb Backspace`
            bindings = <&tog SYMB>;
        };

        combo_sys_left {
            timeout-ms = <100>;
            key-positions = <28 38>; // Combo `v+space`
            bindings = <&mo SYST>;
        };

        combo_sys_right {
            timeout-ms = <100>;
            key-positions = <31 39>; // Combo `m+enter`
            bindings = <&mo SYST>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
//    ┌───────────────┬─────────────┬─────────────┬──────────────┬─────────────┬─────────────────┐                                   ┌─────────────────┬─────────────────┬──────────────┬─────────────┬─────────────┬─────────────┐
//    │      tab      │      Q      │      W      │      E       │      R      │        T        │                                   │        Y        │        U        │      I       │      O      │      P      │    bspc     │
//    ├───────────────┼─────────────┼─────────────┼──────────────┼─────────────┼─────────────────┤                                   ├─────────────────┼─────────────────┼──────────────┼─────────────┼─────────────┼─────────────┤
//    │ &hml lsft esc │ &hml lsft A │ &hml ralt S │ &hml2 SYMB D │ &hml lctl F │   &hml lalt G   │                                   │   &hmr lalt H   │   &hmr rctl J   │ &hmr2 SYMB K │ &hmr ralt L │ &hmr rsft ; │ &hmr rsft ' │
//    ├───────────────┼─────────────┼─────────────┼──────────────┼─────────────┼─────────────────┤                                   ├─────────────────┼─────────────────┼──────────────┼─────────────┼─────────────┼─────────────┤
//    │     lctl      │      Z      │      X      │      C       │ &hml rgui V │        B        │                                   │        N        │   &hmr rgui M   │      ,       │      .      │      /      │    rctl     │
//    └───────────────┴─────────────┴─────────────┴──────────────┼─────────────┼─────────────────┼───────────────┐   ┌───────────────┼─────────────────┼─────────────────┼──────────────┴─────────────┴─────────────┴─────────────┘
//                                                               │   sl FUNC   │ &my_lt MOUS esc │ &hml lgui spc │   │ &hmr lgui ent │ &hmr2 NAVI bspc │ &Compose1ToNpad │
//                                                               └─────────────┴─────────────────┴───────────────┘   └───────────────┴─────────────────┴─────────────────┘
  &kp TAB          &kp Q          &kp W         &kp E          &kp R          &kp T                                                   &kp Y             &kp U             &kp I          &kp O         &kp P             &kp BSPC
  &hml LSHFT ESC   &hml LSHFT A   &hml RALT S   &hml2 SYMB D   &hml LCTRL F   &hml LALT G                                             &hmr LALT H       &hmr RCTRL J      &hmr2 SYMB K   &hmr RALT L   &hmr RSHFT SEMI   &hmr RSHFT SQT
  &kp LCTRL        &kp Z          &kp X         &kp C          &hml RGUI V    &kp B                                                   &kp N             &hmr RGUI M       &kp COMMA      &kp DOT       &kp FSLH          &kp RCTRL
                                                               &sl FUNC       &my_lt MOUS ESC   &hml LGUI SPACE       &hmr LGUI RET   &hmr2 NAVI BSPC   &Compose1ToNpad
            >;
        };

        symb {
            display-name = "SYMB";
            bindings = <
//    ┌─────────┬───────────────┬───────────────┬────────────────┬───────────────┬────────────────┐                       ┌────────────────┬─────────────────┬───────────────┬────────────────┬───────────────┬──────┐
//    │  bspc   │       1       │       2       │       3        │       4       │       5        │                       │       6        │        7        │       8       │       9        │       0       │ bspc │
//    ├─────────┼───────────────┼───────────────┼────────────────┼───────────────┼────────────────┤                       ├────────────────┼─────────────────┼───────────────┼────────────────┼───────────────┼──────┤
//    │ kt SYMB │ &hml lsft esc │ &hml ralt ins │ &hml2 NPAD del │ &hml lctl tab │ &hml lalt bspc │                       │ &hmr lalt left │ &hmr rctl down  │ &hmr2 NPAD up │ &hmr ralt rght │ &hmr rsft ent │  \   │
//    ├─────────┼───────────────┼───────────────┼────────────────┼───────────────┼────────────────┤                       ├────────────────┼─────────────────┼───────────────┼────────────────┼───────────────┼──────┤
//    │  lctl   │       `       │       -       │       =        │    &td_mt0    │      &td2      │                       │       \        │   &hmr rgui '   │       ,       │       .        │       /       │ rctl │
//    └─────────┴───────────────┴───────────────┴────────────────┼───────────────┼────────────────┼─────────┐   ┌─────────┼────────────────┼─────────────────┼───────────────┴────────────────┴───────────────┴──────┘
//                                                               │               │    &td_mt1     │ &td_mt2 │   │ &td_mt3 │    &td_mt4     │ &Compose1ToNpad │
//                                                               └───────────────┴────────────────┴─────────┘   └─────────┴────────────────┴─────────────────┘
  &kp BSPC    &kp N1           &kp N2          &kp N3           &kp N4           &kp N5                                   &kp N6           &kp N7            &kp N8          &kp N9            &kp N0           &kp BSPC
  &kt SYMB    &hml LSHFT ESC   &hml RALT INS   &hml2 NPAD DEL   &hml LCTRL TAB   &hml LALT BSPC                           &hmr LALT LEFT   &hmr RCTRL DOWN   &hmr2 NPAD UP   &hmr RALT RIGHT   &hmr RSHFT RET   &kp BSLH
  &kp LCTRL   &kp GRAVE        &kp MINUS       &kp EQUAL        &td_mt0          &td2                                     &kp BSLH         &hmr RGUI SQT     &kp COMMA       &kp PERIOD        &kp FSLH         &kp RCTRL
                                                                &trans           &td_mt1          &td_mt2       &td_mt3   &td_mt4          &Compose1ToNpad
            >;
        };

        navi {
            display-name = "NAVI";
            bindings = <
//    ┌───────────────┬─────┬─────┬─────┬─────┬──────┐               ┌──────┬──────┬──────┬──────┬──────┬──────┐
//    │      tab      │     │     │     │     │      │               │ home │ del  │ ins  │ end  │ bspc │ bspc │
//    ├───────────────┼─────┼─────┼─────┼─────┼──────┤               ├──────┼──────┼──────┼──────┼──────┼──────┤
//    │ &hml lsft esc │ esc │ ins │ del │ tab │ bspc │               │ left │ down │  up  │ rght │ ent  │ &td0 │
//    ├───────────────┼─────┼─────┼─────┼─────┼──────┤               ├──────┼──────┼──────┼──────┼──────┼──────┤
//    │     lctl      │     │     │     │     │      │               │      │ pgdn │ pgup │      │      │ &td1 │
//    └───────────────┴─────┴─────┴─────┼─────┼──────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴──────┴──────┘
//                                      │     │      │     │   │     │      │      │
//                                      └─────┴──────┴─────┘   └─────┴──────┴──────┘
  &kp TAB          &none     &none     &none     &none     &none                            &kp HOME   &kp DEL     &kp INS     &kp END     &kp BSPC   &kp BSPC
  &hml LSHFT ESC   &kp ESC   &kp INS   &kp DEL   &kp TAB   &kp BSPC                         &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp RET    &td0
  &kp LCTRL        &none     &none     &none     &none     &none                            &none      &kp PG_DN   &kp PG_UP   &none       &none      &td1
                                                 &trans    &trans     &trans       &trans   &trans     &trans
            >;
        };

        mous {
            display-name = "MOUS";
            bindings = <
//    ┌─────┬──────┬──────┬──────┬──────┬──────┐               ┌────────────────┬────────────────┬──────────────┬────────────────┬──────┬─────┐
//    │     │      │      │      │      │      │               │                │                │              │                │      │     │
//    ├─────┼──────┼──────┼──────┼──────┼──────┤               ├────────────────┼────────────────┼──────────────┼────────────────┼──────┼─────┤
//    │     │ mbck │ lclk │ mclk │ rclk │ mfwd │               │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_up │ &mmv MOVE_rght │ lclk │     │
//    ├─────┼──────┼──────┼──────┼──────┼──────┤               ├────────────────┼────────────────┼──────────────┼────────────────┼──────┼─────┤
//    │     │      │      │      │      │      │               │ &msc SCRL_left │ &msc SCRL_down │ &msc SCRL_up │ &msc SCRL_rght │      │     │
//    └─────┴──────┴──────┴──────┼──────┼──────┼─────┐   ┌─────┼────────────────┼────────────────┼──────────────┴────────────────┴──────┴─────┘
//                               │      │      │     │   │     │                │                │
//                               └──────┴──────┴─────┘   └─────┴────────────────┴────────────────┘
  &none    &none      &none       &none       &none       &none                            &none            &none            &none          &none             &none       &none
  &none    &mkp MB4   &mkp LCLK   &mkp MCLK   &mkp RCLK   &mkp MB5                         &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &mkp LCLK   &none
  &trans   &none      &none       &none       &none       &none                            &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP   &msc SCRL_RIGHT   &none       &trans
                                              &trans      &trans     &trans       &trans   &trans           &trans
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
//    ┌─────┬───────────────┬───────────────┬─────┬───────────────┬───────────────┐               ┌───────────────┬───────────────┬─────┬───────────────┬───────────────┬─────┐
//    │     │      f1       │      f2       │ f3  │      f4       │      f5       │               │      f6       │      f7       │ f8  │      f9       │      f10      │     │
//    ├─────┼───────────────┼───────────────┼─────┼───────────────┼───────────────┤               ├───────────────┼───────────────┼─────┼───────────────┼───────────────┼─────┤
//    │     │ &hml lsft f11 │ &hml ralt f12 │ f13 │ &hml lctl f14 │ &hml lalt f15 │               │ &hmr lalt f16 │ &hmr rctl f17 │ f18 │ &hmr ralt f19 │ &hmr rsft f20 │     │
//    ├─────┼───────────────┼───────────────┼─────┼───────────────┼───────────────┤               ├───────────────┼───────────────┼─────┼───────────────┼───────────────┼─────┤
//    │     │      f21      │      f22      │ f23 │ &hml rgui f24 │               │               │               │     rgui      │     │               │               │     │
//    └─────┴───────────────┴───────────────┴─────┼───────────────┼───────────────┼─────┐   ┌─────┼───────────────┼───────────────┼─────┴───────────────┴───────────────┴─────┘
//                                                │               │               │     │   │     │               │               │
//                                                └───────────────┴───────────────┴─────┘   └─────┴───────────────┴───────────────┘
  &trans   &kp F1           &kp F2          &kp F3    &kp F4           &kp F5                                &kp F6          &kp F7           &kp F8    &kp F9          &kp F10          &trans
  &trans   &hml LSHFT F11   &hml RALT F12   &kp F13   &hml LCTRL F14   &hml LALT F15                         &hmr LALT F16   &hmr RCTRL F17   &kp F18   &hmr RALT F19   &hmr RSHFT F20   &trans
  &trans   &kp F21          &kp F22         &kp F23   &hml RGUI F24    &none                                 &none           &kp RGUI         &none     &none           &none            &trans
                                                      &trans           &trans          &trans       &trans   &trans          &trans
            >;
        };

        npad {
            display-name = "NPAD";
            bindings = <
//    ┌──────┬──────┬──────┬─────────────────┬─────┬─────────┐                       ┌─────────┬─────────────────┬──────────────┬───┬──────┬──────┐
//    │ bspc │  U   │  D   │        E        │  F  │    N    │                       │  kp_-   │        7        │      8       │ 9 │  0   │ bspc │
//    ├──────┼──────┼──────┼─────────────────┼─────┼─────────┤                       ├─────────┼─────────────────┼──────────────┼───┼──────┼──────┤
//    │      │ kp_/ │ kp_* │ &hml2 SYMB kp_= │ tab │  bspc   │                       │  nlck   │        4        │ &hml2 SYMB 5 │ 6 │ ent  │      │
//    ├──────┼──────┼──────┼─────────────────┼─────┼─────────┤                       ├─────────┼─────────────────┼──────────────┼───┼──────┼──────┤
//    │      │  X   │  A   │        B        │  C  │    :    │                       │  kp_+   │        1        │      2       │ 3 │ kp_. │      │
//    └──────┴──────┴──────┴─────────────────┼─────┼─────────┼─────────┐   ┌─────────┼─────────┼─────────────────┼──────────────┴───┴──────┴──────┘
//                                           │     │ &td_mt1 │ &td_mt2 │   │ &td_mt3 │ &td_mt4 │ &Compose1ToNpad │
//                                           └─────┴─────────┴─────────┘   └─────────┴─────────┴─────────────────┘
  &kp BSPC   &kp U           &kp D             &kp E                 &kp F     &kp N                                   &kp KP_SUBTRACT   &kp KP_NUMBER_7   &kp KP_NUMBER_8          &kp KP_NUMBER_9   &kp KP_N0      &kp BSPC
  &trans     &kp KP_DIVIDE   &kp KP_MULTIPLY   &hml2 SYMB KP_EQUAL   &kp TAB   &kp BACKSPACE                           &kp KP_NUMLOCK    &kp KP_NUMBER_4   &hml2 SYMB KP_NUMBER_5   &kp KP_NUMBER_6   &kp KP_ENTER   &trans
  &trans     &kp X           &kp A             &kp B                 &kp C     &kp COLON                               &kp KP_PLUS       &kp KP_NUMBER_1   &kp KP_NUMBER_2          &kp KP_NUMBER_3   &kp KP_DOT     &trans
                                                                     &trans    &td_mt1         &td_mt2       &td_mt3   &td_mt4           &Compose1ToNpad
            >;
        };

        syst {
            display-name = "SYST";
            bindings = <
//    ┌────────────┬──────────┬──────────┬──────────┬──────────┬────────────┐               ┌────────────┬──────┬──────┬─────┬─────┬─────┐
//    │            │  bt_clr  │          │          │          │ &sys_reset │               │ &sys_reset │ bri- │ bri+ │     │     │     │
//    ├────────────┼──────────┼──────────┼──────────┼──────────┼────────────┤               ├────────────┼──────┼──────┼─────┼─────┼─────┤
//    │            │          │          │ out_ usb │ out_ ble │            │               │    mute    │ vold │ volu │     │     │     │
//    ├────────────┼──────────┼──────────┼──────────┼──────────┼────────────┤               ├────────────┼──────┼──────┼─────┼─────┼─────┤
//    │ bt_clr_ALL │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │  bt_sel 4  │               │    play    │ prev │ next │     │     │     │
//    └────────────┴──────────┴──────────┴──────────┼──────────┼────────────┼─────┐   ┌─────┼────────────┼──────┼──────┴─────┴─────┴─────┘
//                                                  │          │            │     │   │     │            │      │
//                                                  └──────────┴────────────┴─────┘   └─────┴────────────┴──────┘
  &none            &bt BT_CLR     &none          &none          &none          &sys_reset                           &sys_reset         &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC   &none   &none   &none
  &none            &none          &none          &out OUT_USB   &out OUT_BLE   &none                                &kp C_MUTE         &kp C_VOL_DN           &kp C_VOL_UP           &none   &none   &none
  &bt BT_CLR_ALL   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                         &kp K_PLAY_PAUSE   &kp K_PREV             &kp C_NEXT             &none   &none   &none
                                                                &trans         &trans         &trans       &trans   &trans             &trans
            >;
        };

        comb {
            display-name = "COMB";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐               ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │               │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │               │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤               ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │               │     │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┼─────┼─────┼─────┐   ┌─────┼─────┼─────┼─────┴─────┴─────┴─────┘
//                            │     │     │     │   │     │     │     │
//                            └─────┴─────┴─────┘   └─────┴─────┴─────┘
  &none   &none   &none   &none   &none    &none                          &none    &none    &none   &none   &none   &none
  &none   &none   &none   &none   &none    &none                          &none    &none    &none   &none   &none   &none
  &none   &none   &none   &none   &none    &none                          &none    &none    &none   &none   &none   &none
                                  &trans   &trans   &trans       &trans   &trans   &trans
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
