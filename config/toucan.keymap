#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// To override the default movement or scrolling max velocities 
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Autoshift Macro
#define AS(keycode) &as LS(keycode) keycode     
// Macro to apply momentary-layer-on-hold/toggle-layer-on-tap to a specific layer
#define MO_TOG(layer) &mo_tog layer layer   

#define KEYS_L 0 1 2 3 4 5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38 // left hand
#define KEYS_R 6 7 8 9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41 // right hand
#define BASE   0
#define SYMB   1
#define NAVI   2
#define MOUS   3
#define FUNC   4
#define NPAD   5
#define SYST   6
// #define COMB   7

// https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#mods
// https://v0-3-branch.zmk.dev/docs/keymaps/modifiers
// LS(x), LC(x), LA(x), LG(x), RS(x), RC(x), RA(x), RG(x)

/ {
    // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors#layer-navigation-behaviors
    behaviors {

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        hml2: hml2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };
        hmr2: hmr2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <500>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };

        Compose1ToNpad: Compose1ToNpad {
            compatible = "zmk,behavior-tap-dance";
            label = "Compose1ToNpad";
            #binding-cells = <0>;
            bindings = <&kp K_APP>, <&tog NAVI>;
            tapping-term-ms = <230>;
        };
        
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/hold-tap?examples=mlt#require-prior-idle-ms
        rpi: require_prior_idle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#positional-hold-tap-and-hold-trigger-key-positions
        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <1>;    // <---[[the Q key]]
        };

        // Flavors: "hold-preferred", "balanced", "tap-preferred" and "tap-unless-interrupted"
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // Autoshift applied for QWERTY keys
        // AS(Q) AS(W) AS(E) AS(R) AS(T) AS(Y) 

        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
        // &mo_tog 2 1     // &mo 2 on hold, &tog 1 on tap
        // MO_TOG(3)       // &mo 3 on hold, &tog 3 on tap
        // &mo_tog 4 3     // &mo 4 on hold, &tog 3 on tap

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#summary
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#example-usage
        // Outputs CAPS on a single tap, LS on a single press and hold, and LC when the tap-dance is pressed twice. 
        td_mt: tap_dance_mod_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LSHIFT CAPSLOCK>, <&kp LCTRL>;
        };
        
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#advanced-configuration
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/layers#configuration
        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle On";
            toggle-mode = "on";
        };

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle Off";
            toggle-mode = "off";
        };

        tl_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tl_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/sticky-layer
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/sticky-key
        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
        
        slq: slq {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1500>;
            quick-release;
            ignore-modifiers;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mouse-emulation
        // Mouse Button Press &mkp
        // MB1, LCLK	Left click
        // MB2, RCLK	Right click
        // MB3, MCLK	Middle click
        // MB4	        Mouse button 4
        // MB5	        Mouse button 5
        // &mkp_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Mouse Move &mmv
        // MOVE_UP	    Move up
        // MOVE_DOWN	Move down
        // MOVE_LEFT	Move left
        // MOVE_RIGHT	Move right
        // &mmv_input_listener {
        //     input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Mouse Scroll &msc
        // SCRL_UP	    Scroll up
        // SCRL_DOWN	Scroll down
        // SCRL_LEFT	Scroll left
        // SCRL_RIGHT	Scroll right
        // &msc_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Windows specific 
        // hrm_w: hrm_w {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     tapping-term-ms = <200>;
        //     bindings = <&kp>, <&kp>;
        //     flavor = "tap-preferred";
        //     quick-tap-ms = <200>;
        //     require-prior-idle-ms = <0>;
        //     retro-tap;
        // };

        // my_mtw: my_mtw {
        //     compatible = "zmk,behavior-hold-tap";
        //     #binding-cells = <2>;
        //     flavor = "tap-preferred";
        //     tapping-term-ms = <200>;
        //     bindings = <&kp>, <&kp>;
        // };
    };
    
    combos {
        compatible = "zmk,combos";
        // https://v0-3-branch.zmk.dev/docs/keymaps/combos
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            // layers = <0 1...> 
            bindings = <&kp ESC>;
            // slow-release 
            // require-prior-idle-ms 
        };

        combo_caps1 {
            timeout-ms = <100>;
            key-positions = <36 41>; // Combo `fn + compose`
            bindings = <&kp CAPS>;
        };

        combo_caps2 {
            timeout-ms = <100>;
            key-positions = <12 23>; // Combo `left-shift+right-shift`
            bindings = <&kp CAPS>;
        };

        combo_symbol {
            timeout-ms = <100>;
            key-positions = <37 40>; // Combo `thumb ESC + thumb Backspace`
            bindings = <&tog SYMB>;
        };

        combo_sys_left {
            timeout-ms = <100>;
            key-positions = <28 38>; // Combo `v+space`
            bindings = <&mo SYST>;
        };

        combo_sys_right {
            timeout-ms = <100>;
            key-positions = <31 39>; // Combo `m+enter`
            bindings = <&mo SYST>;
        };
    };
};

/ {
    // conditional_layers {
    //     compatible = "zmk,conditional-layers";
    //     tri_layer {
    //         if-layers = <1 2>;
    //         then-layer = <3>;
    //         };
    //     };

        keymap {
            compatible = "zmk,keymap";

            base {
                display-name = "BASE";
                bindings = <
//    ┌───────────────┬─────────────┬─────────────┬──────────────┬─────────────┬─────────────────┐                                   ┌─────────────────┬─────────────────┬──────────────┬─────────────┬─────────────┬─────────────┐
//    │      tab      │      Q      │      W      │      E       │      R      │        T        │                                   │        Y        │        U        │      I       │      O      │      P      │    bspc     │
//    ├───────────────┼─────────────┼─────────────┼──────────────┼─────────────┼─────────────────┤                                   ├─────────────────┼─────────────────┼──────────────┼─────────────┼─────────────┼─────────────┤
//    │ &hml lsft esc │ &hml lsft A │ &hml ralt S │ &hml2 SYMB D │ &hml lctl F │   &hml lalt G   │                                   │   &hmr lalt H   │   &hmr rctl J   │ &hmr2 SYMB K │ &hmr ralt L │ &hmr rsft ; │ &hmr rsft ' │
//    ├───────────────┼─────────────┼─────────────┼──────────────┼─────────────┼─────────────────┤                                   ├─────────────────┼─────────────────┼──────────────┼─────────────┼─────────────┼─────────────┤
//    │     lctl      │      Z      │      X      │      C       │ &hml rgui V │        B        │                                   │        N        │   &hmr rgui M   │      ,       │      .      │      /      │     esc     │
//    └───────────────┴─────────────┴─────────────┴──────────────┼─────────────┼─────────────────┼───────────────┐   ┌───────────────┼─────────────────┼─────────────────┼──────────────┴─────────────┴─────────────┴─────────────┘
//                                                               │  slq FUNC   │ &my_lt MOUS esc │ &hml lgui spc │   │ &hmr lgui ent │ &hmr2 NAVI bspc │ &Compose1ToNpad │
//                                                               └─────────────┴─────────────────┴───────────────┘   └───────────────┴─────────────────┴─────────────────┘
  &kp TAB          &kp Q          &kp W         &kp E          &kp R          &kp T                                                   &kp Y             &kp U             &kp I          &kp O         &kp P             &kp BSPC
  &hml LSHFT ESC   &hml LSHFT A   &hml RALT S   &hml2 SYMB D   &hml LCTRL F   &hml LALT G                                             &hmr LALT H       &hmr RCTRL J      &hmr2 SYMB K   &hmr RALT L   &hmr RSHFT SEMI   &hmr RSHFT SQT
  &kp LCTRL        &kp Z          &kp X         &kp C          &hml RGUI V    &kp B                                                   &kp N             &hmr RGUI M       &kp COMMA      &kp DOT       &kp FSLH          &kp ESC
                                                               &slq FUNC      &my_lt MOUS ESC   &hml LGUI SPACE       &hmr LGUI RET   &hmr2 NAVI BSPC   &Compose1ToNpad
            >;
        };

            symb {
                display-name = "SYMB";
                bindings = <
//    ┌──────┬────────┬───────┬──────┬────────────┬──────────┐               ┌────────┬──────────────┬───┬───┬───┬──────┐
//    │ tab  │   1    │   2   │  3   │     4      │    5     │               │   6    │      7       │ 8 │ 9 │ 0 │ bspc │
//    ├──────┼────────┼───────┼──────┼────────────┼──────────┤               ├────────┼──────────────┼───┼───┼───┼──────┤
//    │ lsft │  app   │ again │ undo │   K_FIND   │ K_SELECT │               │ C_HELP │      -       │ = │ [ │ ] │  \   │
//    ├──────┼────────┼───────┼──────┼────────────┼──────────┤               ├────────┼──────────────┼───┼───┼───┼──────┤
//    │ lctl │ C_QUIT │  cut  │ copy │ C_AC_PASTE │   caps   │               │   ~    │ C_AC_REFRESH │ , │ . │ / │ esc  │
//    └──────┴────────┴───────┴──────┼────────────┼──────────┼─────┐   ┌─────┼────────┼──────────────┼───┴───┴───┴──────┘
//                                   │    lgui    │          │ spc │   │ ent │        │     ralt     │
//                                   └────────────┴──────────┴─────┘   └─────┴────────┴──────────────┘
  &kp TAB     &kp N1       &kp N2         &kp N3          &kp N4           &kp N5                                   &kp N6       &kp N7             &kp N8      &kp N9     &kp N0     &kp BSPC
  &kp LSHFT   &kp K_APP    &kp K_REDO     &kp K_UNDO      &kp K_FIND       &kp K_SELECT                             &kp C_HELP   &kp MINUS          &kp EQUAL   &kp LBKT   &kp RBKT   &kp BSLH
  &kp LCTRL   &kp C_QUIT   &kp C_AC_CUT   &kp C_AC_COPY   &kp C_AC_PASTE   &kp CAPS                                 &kp TILDE    &kp C_AC_REFRESH   &kp COMMA   &kp DOT    &kp FSLH   &kp ESC
                                                          &kp LGUI         &trans         &kp SPACE       &kp RET   &trans       &kp RALT
            >;
        };

            navi {
                display-name = "NAVI";
                bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

            mous {
                display-name = "MOUS";
                bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

            func {
                display-name = "FUNC";
                bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

            npad {
                display-name = "NPAD";
                bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

            syst {
                display-name = "SYST";
                bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

            comb {
                display-name = "COMB";
                bindings = <
//    ┌──────┬─────┬────┬────┬──────┬─────────┐               ┌─────────┬──────┬──────┬─────┬─────┬──────┐
//    │ tab  │     │ f7 │ f8 │  f9  │   f12   │               │  vold   │ mute │ volu │     │     │ bspc │
//    ├──────┼─────┼────┼────┼──────┼─────────┤               ├─────────┼──────┼──────┼─────┼─────┼──────┤
//    │ lctl │     │ f4 │ f5 │  f6  │   f11   │               │         │      │      │     │     │      │
//    ├──────┼─────┼────┼────┼──────┼─────────┤               ├─────────┼──────┼──────┼─────┼─────┼──────┤
//    │ lsft │     │ f1 │ f2 │  f3  │   f10   │               │         │      │      │     │     │      │
//    └──────┴─────┴────┴────┼──────┼─────────┼─────┐   ┌─────┼─────────┼──────┼──────┴─────┴─────┴──────┘
//                           │ lgui │ mo SYMB │ spc │   │ ent │ mo NAVI │ ralt │
//                           └──────┴─────────┴─────┘   └─────┴─────────┴──────┘
  &kp TAB     &trans   &kp F7   &kp F8   &kp F9     &kp F12                              &kp C_VOL_DN   &kp C_MUTE   &kp C_VOL_UP   &trans   &trans   &kp BSPC
  &kp LCTRL   &trans   &kp F4   &kp F5   &kp F6     &kp F11                              &trans         &trans       &trans         &trans   &trans   &trans
  &kp LSHFT   &trans   &kp F1   &kp F2   &kp F3     &kp F10                              &trans         &trans       &trans         &trans   &trans   &trans
                                         &kp LGUI   &mo SYMB   &kp SPACE       &kp RET   &mo NAVI       &kp RALT
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
