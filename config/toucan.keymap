#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// To override the default movement or scrolling max velocities 
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Autoshift Macro
#define AS(keycode) &as LS(keycode) keycode     
// Macro to apply momentary-layer-on-hold/toggle-layer-on-tap to a specific layer
#define MO_TOG(layer) &mo_tog layer layer   

#define BASE 0
#define SYMB 1
#define NAVI 2 
#define ADJ  3
#define BT   4

// https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#mods
// https://v0-3-branch.zmk.dev/docs/keymaps/modifiers
// LS(x), LC(x), LA(x), LG(x), RS(x), RC(x), RA(x), RG(x)

/ {
    // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors#layer-navigation-behaviors
    behaviors {

        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            #flavor = "balanced";
            flavor = "tap-preferred";
            require-prior-idle-ms = <0>;
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            // List of keys on the right side of the keyboard
            // #hold-trigger-key-positions = < ... >; 
            // #hold-trigger-on-release;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            #flavor = "balanced";
            flavor = "tap-preferred";
            require-prior-idle-ms = <0>;
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            // List of keys on the left side of the keyboard
            // #hold-trigger-key-positions = < ... >; 
            // #hold-trigger-on-release;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#positional-hold-tap-and-hold-trigger-key-positions
        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <1>;    // <---[[the Q key]]
        };

        // Flavors: "hold-preferred", "balanced", "tap-preferred" and "tap-unless-interrupted"
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };

        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <135>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // Autoshift applied for QWERTY keys
        // AS(Q) AS(W) AS(E) AS(R) AS(T) AS(Y) 

        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
        // &mo_tog 2 1     // &mo 2 on hold, &tog 1 on tap
        // MO_TOG(3)       // &mo 3 on hold, &tog 3 on tap
        // &mo_tog 4 3     // &mo 4 on hold, &tog 3 on tap

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#summary
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/tap-dance?examples=advanced#example-usage
        // Outputs CAPSLOCK on a single tap, LSHIFT on a single press and hold, and LCTRL when the tap-dance is pressed twice. 
        td_mt: tap_dance_mod_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LSHIFT CAPSLOCK>, <&kp LCTRL>;
        };
        
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph#advanced-configuration
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/layers#configuration
        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle On";
            toggle-mode = "on";
        };

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle Off";
            toggle-mode = "off";
        };

        tl_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tl_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/sticky-layer
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/sticky-key
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
        
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mouse-emulation
        // Mouse Button Press &mkp
        // MB1, LCLK	Left click
        // MB2, RCLK	Right click
        // MB3, MCLK	Middle click
        // MB4	        Mouse button 4
        // MB5	        Mouse button 5
        // &mkp_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Mouse Move &mmv
        // MOVE_UP	    Move up
        // MOVE_DOWN	Move down
        // MOVE_LEFT	Move left
        // MOVE_RIGHT	Move right
        // &mmv_input_listener {
        //     input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Mouse Scroll &msc
        // SCRL_UP	    Scroll up
        // SCRL_DOWN	Scroll down
        // SCRL_LEFT	Scroll left
        // SCRL_RIGHT	Scroll right
        // &msc_input_listener {
        //    input-processors = <&zip_temp_layer 2 2000>;
        // }

        // Windows specific 
        hrm_w: hrm_w {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
            retro-tap;
        };

        my_mtw: my_mtw {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };
    
    combos {
        compatible = "zmk,combos";
        // https://v0-3-branch.zmk.dev/docs/keymaps/combos
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            // layers = <0 1...> 
            bindings = <&kp ESC>;
            // slow-release 
            // require-prior-idle-ms 
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
            };
        };

        keymap {
            compatible = "zmk,keymap";

            base {
                display-name = "BASE";
                bindings = <
//    ┌──────┬───┬───┬───┬──────┬─────────┐               ┌─────────┬──────┬───┬───┬───┬──────┐
//    │ tab  │ Q │ W │ E │  R   │    T    │               │    Y    │  U   │ I │ O │ P │ bspc │
//    ├──────┼───┼───┼───┼──────┼─────────┤               ├─────────┼──────┼───┼───┼───┼──────┤
//    │ lsft │ A │ S │ D │  F   │    G    │               │    H    │  J   │ K │ L │ ; │  '   │
//    ├──────┼───┼───┼───┼──────┼─────────┤               ├─────────┼──────┼───┼───┼───┼──────┤
//    │ lctl │ Z │ X │ C │  V   │    B    │               │    N    │  M   │ , │ . │ / │ esc  │
//    └──────┴───┴───┴───┼──────┼─────────┼─────┐   ┌─────┼─────────┼──────┼───┴───┴───┴──────┘
//                       │ lgui │ mo SYMB │ spc │   │ ent │ mo NAVI │ ralt │
//                       └──────┴─────────┴─────┘   └─────┴─────────┴──────┘
  &kp TAB     &kp Q   &kp W   &kp E   &kp R      &kp T                                &kp Y      &kp U      &kp I       &kp O     &kp P      &kp BSPC
  &kp LSHFT   &kp A   &kp S   &kp D   &kp F      &kp G                                &kp H      &kp J      &kp K       &kp L     &kp SEMI   &kp SQT
  &kp LCTRL   &kp Z   &kp X   &kp C   &kp V      &kp B                                &kp N      &kp M      &kp COMMA   &kp DOT   &kp FSLH   &kp ESC
                                      &kp LGUI   &mo SYMB   &kp SPACE       &kp RET   &mo NAVI   &kp RALT
            >;
        };

        sym {
            display-name = "SYMB";
            bindings = <
//    ┌──────┬────────┬───────┬──────┬────────────┬──────────┐               ┌────────┬──────────────┬───┬───┬───┬──────┐
//    │ tab  │   1    │   2   │  3   │     4      │    5     │               │   6    │      7       │ 8 │ 9 │ 0 │ bspc │
//    ├──────┼────────┼───────┼──────┼────────────┼──────────┤               ├────────┼──────────────┼───┼───┼───┼──────┤
//    │ lsft │  app   │ again │ undo │   K_FIND   │ K_SELECT │               │ C_HELP │      -       │ = │ [ │ ] │  \   │
//    ├──────┼────────┼───────┼──────┼────────────┼──────────┤               ├────────┼──────────────┼───┼───┼───┼──────┤
//    │ lctl │ C_QUIT │  cut  │ copy │ C_AC_PASTE │   caps   │               │   ~    │ C_AC_REFRESH │ , │ . │ / │ esc  │
//    └──────┴────────┴───────┴──────┼────────────┼──────────┼─────┐   ┌─────┼────────┼──────────────┼───┴───┴───┴──────┘
//                                   │    lgui    │          │ spc │   │ ent │        │     ralt     │
//                                   └────────────┴──────────┴─────┘   └─────┴────────┴──────────────┘
  &kp TAB     &kp N1       &kp N2         &kp N3          &kp N4           &kp N5                                   &kp N6       &kp N7             &kp N8      &kp N9     &kp N0     &kp BSPC
  &kp LSHFT   &kp K_APP    &kp K_REDO     &kp K_UNDO      &kp K_FIND       &kp K_SELECT                             &kp C_HELP   &kp MINUS          &kp EQUAL   &kp LBKT   &kp RBKT   &kp BSLH
  &kp LCTRL   &kp C_QUIT   &kp C_AC_CUT   &kp C_AC_COPY   &kp C_AC_PASTE   &kp CAPS                                 &kp TILDE    &kp C_AC_REFRESH   &kp COMMA   &kp DOT    &kp FSLH   &kp ESC
                                                          &kp LGUI         &trans         &kp SPACE       &kp RET   &trans       &kp RALT
            >;
        };

        nav {
            display-name = "NAVI";
            bindings = <
//    ┌──────┬─────┬─────┬─────┬──────┬─────┐               ┌──────┬──────┬──────┬──────┬─────────────────┬───────────┐
//    │ tab  │  1  │  2  │  3  │  4   │  5  │               │  6   │  7   │  8   │  9   │        0        │   bspc    │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lsft │     │     │     │      │     │               │ left │ down │  up  │ rght │     lgui([)     │  lgui(])  │
//    ├──────┼─────┼─────┼─────┼──────┼─────┤               ├──────┼──────┼──────┼──────┼─────────────────┼───────────┤
//    │ lctl │     │     │     │      │     │               │ home │ pgdn │ pgup │ end  │ lsft(lctl(tab)) │ lctl(tab) │
//    └──────┴─────┴─────┴─────┼──────┼─────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴─────────────────┴───────────┘
//                             │ lgui │     │ spc │   │ ent │      │ ralt │
//                             └──────┴─────┴─────┘   └─────┴──────┴──────┘
  &kp TAB     &kp N1   &kp N2   &kp N3   &kp N4     &kp N5                             &kp N6     &kp N7      &kp N8      &kp N9      &kp N0            &kp BSPC
  &kp LSHFT   &trans   &trans   &trans   &trans     &trans                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)      &kp LG(RBKT)
  &kp LCTRL   &trans   &trans   &trans   &trans     &trans                             &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LS(LC(TAB))   &kp LC(TAB)
                                         &kp LGUI   &trans   &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
//    ┌──────┬─────┬────┬────┬──────┬─────────┐               ┌─────────┬──────┬──────┬─────┬─────┬──────┐
//    │ tab  │     │ f7 │ f8 │  f9  │   f12   │               │  vold   │ mute │ volu │     │     │ bspc │
//    ├──────┼─────┼────┼────┼──────┼─────────┤               ├─────────┼──────┼──────┼─────┼─────┼──────┤
//    │ lctl │     │ f4 │ f5 │  f6  │   f11   │               │         │      │      │     │     │      │
//    ├──────┼─────┼────┼────┼──────┼─────────┤               ├─────────┼──────┼──────┼─────┼─────┼──────┤
//    │ lsft │     │ f1 │ f2 │  f3  │   f10   │               │         │      │      │     │     │      │
//    └──────┴─────┴────┴────┼──────┼─────────┼─────┐   ┌─────┼─────────┼──────┼──────┴─────┴─────┴──────┘
//                           │ lgui │ mo SYMB │ spc │   │ ent │ mo NAVI │ ralt │
//                           └──────┴─────────┴─────┘   └─────┴─────────┴──────┘
  &kp TAB     &trans   &kp F7   &kp F8   &kp F9     &kp F12                              &kp C_VOL_DN   &kp C_MUTE   &kp C_VOL_UP   &trans   &trans   &kp BSPC
  &kp LCTRL   &trans   &kp F4   &kp F5   &kp F6     &kp F11                              &trans         &trans       &trans         &trans   &trans   &trans
  &kp LSHFT   &trans   &kp F1   &kp F2   &kp F3     &kp F10                              &trans         &trans       &trans         &trans   &trans   &trans
                                         &kp LGUI   &mo SYMB   &kp SPACE       &kp RET   &mo NAVI       &kp RALT
            >;
        };

        bt {
            display-name = "BT";
            bindings = <
//    ┌────────┬────────────────┬──────────┬──────────┬──────────┬──────────┐               ┌──────┬──────┬──────┬──────┬───────────┬─────────────────┐
//    │  tab   │       1        │    2     │    3     │    4     │    5     │               │  6   │  7   │  8   │  9   │     0     │      bspc       │
//    ├────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤               ├──────┼──────┼──────┼──────┼───────────┼─────────────────┤
//    │ bt_clr │    bt_sel 0    │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │               │ left │ down │  up  │ rght │  lgui([)  │     lgui(])     │
//    ├────────┼────────────────┼──────────┼──────────┼──────────┼──────────┤               ├──────┼──────┼──────┼──────┼───────────┼─────────────────┤
//    │  lsft  │ &studio_unlock │          │          │          │          │               │ home │ pgdn │ pgup │ end  │ lctl(tab) │ lsft(lctl(tab)) │
//    └────────┴────────────────┴──────────┴──────────┼──────────┼──────────┼─────┐   ┌─────┼──────┼──────┼──────┴──────┴───────────┴─────────────────┘
//                                                    │   lgui   │          │ spc │   │ ent │      │ ralt │
//                                                    └──────────┴──────────┴─────┘   └─────┴──────┴──────┘
  &kp TAB      &kp N1           &kp N2         &kp N3         &kp N4         &kp N5                                   &kp N6     &kp N7      &kp N8      &kp N9      &kp N0         &kp BSPC
  &bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                             &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &kp LG(LBKT)   &kp LG(RBKT)
  &kp LSHFT    &studio_unlock   &trans         &trans         &trans         &trans                                   &kp HOME   &kp PG_DN   &kp PG_UP   &kp END     &kp LC(TAB)    &kp LS(LC(TAB))
                                                              &kp LGUI       &trans         &kp SPACE       &kp RET   &trans     &kp RALT
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
